rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if only friend_ids field is being updated
    function isOnlyUpdatingFriendIds() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return affectedKeys.hasOnly(['friend_ids']);
    }
    
    // Helper function to check if user is a group member
    function isGroupMember(groupData) {
      return isAuthenticated() && 
             request.auth.uid in groupData.member_ids;
    }
    
    // Main artifacts collection
    match /artifacts/{appId}/users/{userId} {
      
      // User profile document
      match /user_data/profile {
        // Anyone authenticated can read profiles (needed to see friends)
        allow read: if isAuthenticated();
        
        // Users can write to their own profile
        allow write: if isOwner(userId);
        
        // SPECIAL: Allow updating friend_ids for friend requests
        allow update: if isAuthenticated() && isOnlyUpdatingFriendIds();
      }
      
      // Private expenses - users can only access their own
      match /private_expenses/{expenseId} {
        allow read, write: if isOwner(userId);
      }
      
      // Allow reading user documents (for collection queries)
      allow read: if isAuthenticated();
    }
    
    // Collection group queries for user_data
    match /{path=**}/user_data/{document} {
      allow read: if isAuthenticated();
    }
    
    // PUBLIC GROUPS COLLECTION
    match /artifacts/{appId}/public/data/groups/{groupId} {
      // Anyone authenticated can read groups
      allow read: if isAuthenticated();
      
      // Only authenticated users can create groups
      allow create: if isAuthenticated();
      
      // Only group members can update/delete
      allow update, delete: if isAuthenticated() && 
                                isGroupMember(resource.data);
      
      // GROUP EXPENSES SUBCOLLECTION
      match /expenses/{expenseId} {
        // Only group members can read expenses
        allow read: if isAuthenticated() && 
                       isGroupMember(get(/databases/$(database)/documents/artifacts/$(appId)/public/data/groups/$(groupId)).data);
        
        // Only group members can create/update/delete expenses
        allow write: if isAuthenticated() && 
                        isGroupMember(get(/databases/$(database)/documents/artifacts/$(appId)/public/data/groups/$(groupId)).data);
      }
    }
  }
}

